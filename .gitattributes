# Shell scripts run on Linux/macOS (and are streamed to remote `sh`), so they
# keep LF endings even in a Windows checkout with core.autocrlf.
*.sh text eol=lf
# Programs started through their #! line: the kernel reads that line byte for
# byte, so a CRLF checkout asks for "node\r" or "sh\r". bin/ is also packed by
# a Windows hub for the Linux and macOS nodes it installs (lib/hub/node-installer.js).
bin/* text eol=lf
*.mjs text eol=lf
scripts/*.js text eol=lf
android/gradlew text eol=lf
# cmd.exe misreads labels and long lines in LF batch files.
*.cmd text eol=crlf
# Vendored tmux plugins are bash scripts with other extensions too (*.tmux).
vendor/tmux-plugins/** text eol=lf
# Unified patches contain blank context lines and space-prefixed C tabs.
scripts/tmux-patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
