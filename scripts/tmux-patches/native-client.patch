+/* Native PTY transport for panel clients. The child remains a normal tmux client. */
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <sys/wait.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "tmux.h"
+
+#define PANEL_INPUT_LIMIT (1024 * 1024)
+#define PANEL_OUTPUT_LIMIT (8 * 1024 * 1024)
+#define PANEL_CHUNK 65536
+
+static volatile sig_atomic_t panel_stop;
+
+static void
+panel_signal(int sig)
+{
+	if (sig != SIGCHLD)
+		panel_stop = 1;
+}
+
+static uint32_t
+panel_number(const u_char *p)
+{
+	return ((uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 |
+	    (uint32_t)p[2] << 8 | p[3]);
+}
+
+static int
+panel_frame(struct evbuffer *out, int type, const void *data, size_t size)
+{
+	u_char header[5];
+
+	if (size > PANEL_INPUT_LIMIT ||
+	    EVBUFFER_LENGTH(out) + sizeof header + size > PANEL_OUTPUT_LIMIT)
+		return (-1);
+	header[0] = type;
+	header[1] = size >> 24;
+	header[2] = size >> 16;
+	header[3] = size >> 8;
+	header[4] = size;
+	evbuffer_add(out, header, sizeof header);
+	evbuffer_add(out, data, size);
+	return (0);
+}
+
+static int
+panel_input(struct evbuffer *in, struct evbuffer *pending, int fd, pid_t pid)
+{
+	const u_char *data;
+	uint32_t size, cols, rows;
+	struct winsize ws;
+
+	while (EVBUFFER_LENGTH(in) >= 5) {
+		data = EVBUFFER_DATA(in);
+		size = panel_number(data + 1);
+		if (size > PANEL_INPUT_LIMIT)
+			return (-1);
+		if (EVBUFFER_LENGTH(in) < 5 + size)
+			return (0);
+		switch (data[0]) {
+		case 'I':
+			if (EVBUFFER_LENGTH(pending) + size > PANEL_INPUT_LIMIT)
+				return (-1);
+			evbuffer_add(pending, data + 5, size);
+			break;
+		case 'R':
+			if (size != 8)
+				return (-1);
+			/* Preserve input/resize ordering across short PTY writes. */
+			if (EVBUFFER_LENGTH(pending) != 0)
+				return (0);
+			cols = panel_number(data + 5);
+			rows = panel_number(data + 9);
+			if (cols < 2 || cols > 4096 || rows < 2 || rows > 4096)
+				return (-1);
+			memset(&ws, 0, sizeof ws);
+			ws.ws_col = cols;
+			ws.ws_row = rows;
+			if (ioctl(fd, TIOCSWINSZ, &ws) == -1)
+				return (-1);
+			/* Some PTY implementations do not notify the client itself. */
+			kill(pid, SIGWINCH);
+			break;
+		case 'X':
+			return (size == 0 ? 1 : -1);
+		default:
+			return (-1);
+		}
+		evbuffer_drain(in, size + 5);
+	}
+	return (0);
+}
+
+/* Returns only in the forkpty child, which continues through the usual main. */
+void
+panel_pty_main(int *argc, char ***argv)
+{
+	struct evbuffer *in, *pending, *out;
+	struct pollfd fds[3];
+	struct sigaction sa;
+	struct winsize ws;
+	char name[PATH_MAX], hello[PATH_MAX + 100], result[100], extra;
+	u_char data[PANEL_CHUNK];
+	u_int cols, rows;
+	int fd, status = 0, reaped = 0, closing = 0, failed = 0, ended = 0;
+	int n, rc, code, killed = 0;
+	ssize_t count;
+	pid_t pid, waited;
+	uint64_t deadline = 0, now;
+	size_t room;
+
+	if (*argc < 4 || sscanf((*argv)[2], "%ux%u%c", &cols, &rows,
+	    &extra) != 2 || cols < 2 || cols > 4096 || rows < 2 || rows > 4096)
+		errx(1, "--panel-pty requires COLSxROWS (2..4096) and tmux arguments");
+	memset(&ws, 0, sizeof ws);
+	ws.ws_col = cols;
+	ws.ws_row = rows;
+	pid = forkpty(&fd, name, NULL, &ws);
+	if (pid == -1)
+		err(1, "forkpty");
+	if (pid == 0) {
+		*argc -= 2;
+		memmove(*argv + 1, *argv + 3, *argc * sizeof **argv);
+		optind = 1;
+		return;
+	}
+
+	memset(&sa, 0, sizeof sa);
+	sigemptyset(&sa.sa_mask);
+	sa.sa_handler = panel_signal;
+	sigaction(SIGCHLD, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGHUP, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
+	sa.sa_handler = SIG_IGN;
+	sigaction(SIGPIPE, &sa, NULL);
+	setblocking(STDIN_FILENO, 0);
+	setblocking(STDOUT_FILENO, 0);
+	setblocking(fd, 0);
+	in = evbuffer_new();
+	pending = evbuffer_new();
+	out = evbuffer_new();
+	if (in == NULL || pending == NULL || out == NULL) {
+		close(fd);
+		kill(pid, SIGHUP);
+		_exit(1);
+	}
+	/* PTY paths contain no JSON metacharacters on supported platforms. */
+	if (strpbrk(name, "\"\\\n\r") != NULL) {
+		close(fd);
+		kill(pid, SIGHUP);
+		_exit(1);
+	}
+	n = xsnprintf(hello, sizeof hello,
+	    "{\"protocol\":1,\"pid\":%ld,\"tty\":\"%s\"}", (long)pid, name);
+	panel_frame(out, 'H', hello, n);
+
+	for (;;) {
+		now = get_timer();
+		if (!reaped) {
+			waited = waitpid(pid, &status, WNOHANG);
+			if (waited == pid) {
+				reaped = 1;
+				deadline = now + 2000;
+			} else if (waited == -1 && errno != EINTR) {
+				reaped = failed = 1;
+				status = 1 << 8;
+				deadline = now + 2000;
+			}
+		}
+		if (!closing && !reaped && !panel_stop) {
+			rc = panel_input(in, pending, fd, pid);
+			if (rc != 0) {
+				closing = 1;
+				failed = rc < 0;
+			}
+		}
+		if (panel_stop)
+			closing = 1;
+		if (closing && fd != -1) {
+			close(fd);
+			fd = -1;
+			if (!reaped)
+				kill(pid, SIGHUP);
+			deadline = now + 2000;
+			if (failed)
+				evbuffer_drain(out, EVBUFFER_LENGTH(out));
+		}
+		if (reaped && (fd == -1 || now >= deadline) && !ended) {
+			if (fd != -1) {
+				close(fd);
+				fd = -1;
+			}
+			if (WIFSIGNALED(status))
+				n = xsnprintf(result, sizeof result,
+				    "{\"exitCode\":null,\"signal\":%d}", WTERMSIG(status));
+			else {
+				code = WIFEXITED(status) ? WEXITSTATUS(status) : 1;
+				n = xsnprintf(result, sizeof result,
+				    "{\"exitCode\":%d,\"signal\":null}", code);
+			}
+			if (panel_frame(out, 'E', result, n) != 0)
+				failed = 1;
+			ended = 1;
+			deadline = now + 2000;
+		}
+		if (ended && (EVBUFFER_LENGTH(out) == 0 || now >= deadline))
+			break;
+		if (closing && !reaped && now >= deadline) {
+			if (killed)
+				_exit(1);
+			killed = 1;
+			kill(pid, SIGKILL);
+			deadline = now + 2000;
+		}
+		memset(fds, 0, sizeof fds);
+		fds[0].fd = closing || reaped ? -1 : STDIN_FILENO;
+		room = PANEL_INPUT_LIMIT + 5 - EVBUFFER_LENGTH(in) -
+		    EVBUFFER_LENGTH(pending);
+		/* Keep observing EOF even when a socketpair input queue is full. */
+		fds[0].events = POLLIN;
+		fds[1].fd = STDOUT_FILENO;
+		fds[1].events = EVBUFFER_LENGTH(out) != 0 ? POLLOUT : 0;
+		fds[2].fd = fd;
+		fds[2].events = POLLIN;
+		if (EVBUFFER_LENGTH(pending) != 0 && !reaped)
+			fds[2].events |= POLLOUT;
+		rc = poll(fds, 3, 100);
+		if (rc == -1) {
+			if (errno == EINTR)
+				continue;
+			failed = closing = 1;
+			continue;
+		}
+		if (fds[1].revents & (POLLERR|POLLHUP|POLLNVAL)) {
+			failed = closing = 1;
+			evbuffer_drain(out, EVBUFFER_LENGTH(out));
+		} else if (fds[1].revents & POLLOUT) {
+			count = write(STDOUT_FILENO, EVBUFFER_DATA(out), EVBUFFER_LENGTH(out));
+			if (count > 0)
+				evbuffer_drain(out, count);
+			else if (count < 0 && errno != EINTR && errno != EAGAIN)
+				failed = closing = 1;
+		}
+		if (fds[0].revents & (POLLIN|POLLHUP|POLLERR)) {
+			if (room > sizeof data)
+				room = sizeof data;
+			count = read(STDIN_FILENO, data, room != 0 ? room : 1);
+			if (count > 0 && room == 0)
+				failed = closing = 1;
+			else if (count > 0)
+				evbuffer_add(in, data, count);
+			else if (count == 0 || (errno != EINTR && errno != EAGAIN))
+				closing = 1;
+		}
+		if (fd != -1 && (fds[2].revents & POLLOUT)) {
+			count = write(fd, EVBUFFER_DATA(pending), EVBUFFER_LENGTH(pending));
+			if (count > 0)
+				evbuffer_drain(pending, count);
+			else if (count < 0 && errno != EINTR && errno != EAGAIN)
+				failed = closing = 1;
+		}
+		if (fd != -1 && (fds[2].revents & (POLLIN|POLLHUP|POLLERR))) {
+			count = read(fd, data, sizeof data);
+			if (count > 0) {
+				if (panel_frame(out, 'O', data, count) != 0)
+					failed = closing = 1;
+			} else if (count == 0 || (errno != EINTR && errno != EAGAIN)) {
+				close(fd);
+				fd = -1;
+				if (!reaped) {
+					closing = 1;
+					kill(pid, SIGHUP);
+					deadline = now + 2000;
+				}
+			}
+		}
+	}
+	/* Never restore blocking stdout or run a stdio flush on this binary pipe. */
+	_exit(failed ? 1 : 0);
+}
