+/* A checkpoint for control clients. Unlike capture-pane text, this includes
+ * the parser's current pen and saved state, so the next byte has the same
+ * meaning after reconnect. It never writes to or resets the running pane. */
+static void
+input_snapshot_pen(struct evbuffer *out, struct screen *s,
+    const struct grid_cell *cell)
+{
+	struct grid_cell gc = *cell;
+	char code[8192];
+	int link = 0;
+
+	gc.attr &= ~GRID_ATTR_CHARSET;
+	evbuffer_add_printf(out, "\033[0m\033]8;;\033\\");
+	grid_string_cells_code(&grid_default_cell, &gc, code, sizeof code,
+	    GRID_STRING_WITH_SEQUENCES, s, &link);
+	evbuffer_add(out, code, strlen(code));
+}
+
+static void
+input_snapshot_charset(struct evbuffer *out, const struct input_cell *cell)
+{
+	evbuffer_add_printf(out, "\033(%c\033)%c%c", cell->g0set ? '0' : 'B',
+	    cell->g1set ? '0' : 'B', cell->set ? '\016' : '\017');
+}
+
+/* Paint real cells, expanding stored tabs rather than interpreting them using
+ * today's tab stops. Full rows preserve wrapped-line boundaries. */
+static void
+input_snapshot_line(struct evbuffer *out, struct screen *s, struct grid *gd,
+    u_int y, u_int width)
+{
+	struct grid_cell gc, last = grid_default_cell;
+	char code[8192];
+	u_int x, n;
+	int link = 0;
+
+	evbuffer_add_printf(out, "\033[0m\017\033(B\033)0");
+	for (x = 0; x < width; x++) {
+		grid_get_cell(gd, x, y, &gc);
+		if (gc.flags & GRID_FLAG_PADDING)
+			continue;
+		grid_string_cells_code(&last, &gc, code, sizeof code,
+		    GRID_STRING_WITH_SEQUENCES, s, &link);
+		evbuffer_add(out, code, strlen(code));
+		last = gc;
+		if (gc.flags & GRID_FLAG_TAB) {
+			for (n = 0; n < gc.data.width; n++)
+				evbuffer_add(out, " ", 1);
+		} else
+			evbuffer_add(out, gc.data.data, gc.data.size);
+	}
+	evbuffer_add_printf(out, "\033]8;;\033\\");
+}
+
+static void
+input_snapshot_grid(struct evbuffer *out, struct screen *s, struct grid *gd,
+    u_int first, u_int count, u_int width)
+{
+	u_int y;
+	const struct grid_line *line;
+
+	for (y = first; y < first + count; y++) {
+		input_snapshot_line(out, s, gd, y, width);
+		line = grid_peek_line(gd, y);
+		if (y + 1 < first + count &&
+		    (line == NULL || (~line->flags & GRID_LINE_WRAPPED)))
+			evbuffer_add(out, "\r\n", 2);
+	}
+}
+
+static void
+input_snapshot_colour(struct evbuffer *out, int command, int index, int colour)
+{
+	u_char r, g, b;
+	if (colour < 0 || !(colour & COLOUR_FLAG_RGB))
+		return;
+	colour_split_rgb(colour, &r, &g, &b);
+	if (command == 4)
+		evbuffer_add_printf(out, "\033]4;%d;rgb:%02x/%02x/%02x\033\\",
+		    index, r, g, b);
+	else
+		evbuffer_add_printf(out, "\033]%d;rgb:%02x/%02x/%02x\033\\",
+		    command, r, g, b);
+}
+
+/* Restore a copy when the application resized inside the alternate screen.
+ * The saved normal grid still has its original width. Cropping it to today's
+ * width loses cells; use tmux's own alternate-screen restore and reflow, without
+ * changing the live pane. Copy only the checkpoint's bounded history. */
+static void
+input_snapshot_normal(struct screen *s, struct screen *normal)
+{
+	struct grid *gd;
+	u_int hsize = s->grid->hsize > 2000 ? 2000 : s->grid->hsize;
+
+	screen_init(normal, screen_size_x(s), screen_size_y(s), 2000);
+	gd = normal->grid;
+	gd->linedata = xreallocarray(gd->linedata, hsize + gd->sy,
+	    sizeof *gd->linedata);
+	memset(gd->linedata + gd->sy, 0, hsize * sizeof *gd->linedata);
+	gd->hsize = hsize;
+	gd->flags = s->grid->flags;
+	grid_duplicate_lines(gd, 0, s->grid, s->grid->hsize - hsize,
+	    hsize + gd->sy);
+	normal->saved_grid = grid_create(s->saved_grid->sx,
+	    s->saved_grid->sy, 0);
+	grid_duplicate_lines(normal->saved_grid, 0, s->saved_grid, 0,
+	    s->saved_grid->sy);
+	normal->cx = s->cx;
+	normal->cy = s->cy;
+	normal->mode = s->mode;
+	normal->saved_cx = s->saved_cx;
+	normal->saved_cy = s->saved_cy;
+	normal->saved_cell = s->saved_cell;
+	normal->saved_flags = s->saved_flags;
+	screen_alternate_off(normal, NULL, 1);
+}
+
+struct evbuffer *
+input_snapshot(struct window_pane *wp)
+{
+	struct input_ctx *ictx = wp->ictx;
+	struct screen *s = &wp->base;
+	struct screen normal;
+	struct grid *history = s->grid, *saved = s->saved_grid;
+	struct evbuffer *out = evbuffer_new();
+	struct grid_cell gc;
+	u_int x, y, sx = screen_size_x(s), sy = screen_size_y(s), first;
+	u_int saved_cx = s->saved_cx, saved_cy = s->saved_cy;
+	int reflow = saved != NULL && (saved->sx != sx || saved->sy != sy);
+	int mode = s->mode, cursor;
+	static const struct { int flag; int number; } modes[] = {
+		{ MODE_KCURSOR, 1 }, { MODE_WRAP, 7 }, { MODE_CURSOR, 25 },
+		{ MODE_MOUSE_STANDARD, 1000 }, { MODE_MOUSE_BUTTON, 1002 },
+		{ MODE_MOUSE_ALL, 1003 }, { MODE_FOCUSON, 1004 },
+		{ MODE_MOUSE_UTF8, 1005 }, { MODE_MOUSE_SGR, 1006 },
+		{ MODE_BRACKETPASTE, 2004 }, { MODE_THEME_UPDATES, 2031 }
+	};
+	if (reflow) {
+		input_snapshot_normal(s, &normal);
+		history = saved = normal.grid;
+		saved_cx = normal.cx;
+		saved_cy = normal.cy;
+	}
+
+	/* RIS clears old parser state, palette and both buffers in xterm. */
+	evbuffer_add_printf(out, "\033c\033[?25l\033[?7h\033[?6l\033[4l");
+	input_snapshot_colour(out, 10, 0, wp->palette.fg);
+	input_snapshot_colour(out, 11, 0, wp->palette.bg);
+	input_snapshot_colour(out, 12, 0, s->ccolour);
+	if (wp->palette.palette != NULL) {
+		for (x = 0; x < 256; x++)
+			input_snapshot_colour(out, 4, x, wp->palette.palette[x]);
+	}
+	/* Bound the checkpoint; older scrollback is retrieved on demand. */
+	first = history->hsize > 2000 ? history->hsize - 2000 : 0;
+	if (history->hsize > first) {
+		input_snapshot_grid(out, s, history, first,
+		    history->hsize - first, sx);
+		evbuffer_add(out, "\r\n", 2);
+	}
+	if (s->saved_grid != NULL) {
+		input_snapshot_grid(out, s, saved, saved->hsize, saved->sy, sx);
+		input_snapshot_pen(out, s, &s->saved_cell);
+		evbuffer_add_printf(out, "\033[%u;%uH\033[?1049h\033[H",
+		    saved_cy < sy ? saved_cy + 1 : 1,
+		    saved_cx < sx ? saved_cx + 1 : sx);
+		input_snapshot_grid(out, s, s->grid, s->grid->hsize, sy, sx);
+	} else
+		input_snapshot_grid(out, s, s->grid, s->grid->hsize, sy, sx);
+	if (reflow)
+		screen_free(&normal);
+
+	/* Tab stops and scrolling margins are independent of drawn cells. */
+	evbuffer_add_printf(out, "\033[3g");
+	for (x = 0; x < sx; x++) {
+		if (bit_test(s->tabs, x))
+			evbuffer_add_printf(out, "\033[1;%uH\033H", x + 1);
+	}
+	evbuffer_add_printf(out, "\033[%u;%ur", s->rupper + 1, s->rlower + 1);
+
+	/* DECSC state must be installed before the live cursor/pen. */
+	evbuffer_add_printf(out, "\033[?6%c", ictx->old_mode & MODE_ORIGIN ? 'h' : 'l');
+	y = ictx->old_cy;
+	if ((ictx->old_mode & MODE_ORIGIN) && y >= s->rupper)
+		y -= s->rupper;
+	evbuffer_add_printf(out, "\033[%u;%uH", y + 1,
+	    ictx->old_cx < sx ? ictx->old_cx + 1 : sx);
+	input_snapshot_pen(out, s, &ictx->old_cell.cell);
+	input_snapshot_charset(out, &ictx->old_cell);
+	evbuffer_add_printf(out, "\0337\033[?6%c", mode & MODE_ORIGIN ? 'h' : 'l');
+	y = s->cy;
+	if ((mode & MODE_ORIGIN) && y >= s->rupper)
+		y -= s->rupper;
+	evbuffer_add_printf(out, "\033[%u;%uH", y + 1,
+	    s->cx < sx ? s->cx + 1 : sx);
+	/* Restore deferred autowrap by repainting the final cell in place. */
+	if (s->cx >= sx) {
+		x = sx - 1;
+		grid_get_cell(s->grid, x, s->grid->hsize + s->cy, &gc);
+		if ((gc.flags & GRID_FLAG_PADDING) && x > 0) {
+			x--;
+			grid_get_cell(s->grid, x, s->grid->hsize + s->cy, &gc);
+			evbuffer_add_printf(out, "\033[%u;%uH", y + 1, x + 1);
+		}
+		input_snapshot_pen(out, s, &gc);
+		evbuffer_add(out, gc.data.data, gc.data.size);
+	}
+	input_snapshot_pen(out, s, &ictx->cell.cell);
+	input_snapshot_charset(out, &ictx->cell);
+	/* Reset first: DECRST of any mouse tracking mode clears all of them. */
+	for (x = 0; x < nitems(modes); x++) {
+		if (~mode & modes[x].flag)
+			evbuffer_add_printf(out, "\033[?%dl", modes[x].number);
+	}
+	for (x = 0; x < nitems(modes); x++) {
+		if (mode & modes[x].flag)
+			evbuffer_add_printf(out, "\033[?%dh", modes[x].number);
+	}
+	evbuffer_add_printf(out, "\033[4%c\033[20%c\033%c",
+	    mode & MODE_INSERT ? 'h' : 'l', mode & MODE_CRLF ? 'h' : 'l',
+	    mode & MODE_KKEYPAD ? '=' : '>');
+	cursor = s->cstyle == SCREEN_CURSOR_UNDERLINE ? 4 :
+	    (s->cstyle == SCREEN_CURSOR_BAR ? 6 : 2);
+	if (mode & MODE_CURSOR_BLINKING)
+		cursor--;
+	evbuffer_add_printf(out, "\033[%d q", cursor);
+	if (mode & EXTENDED_KEY_MODES)
+		evbuffer_add_printf(out, "\033[>4;%dm",
+		    mode & MODE_KEYS_EXTENDED_2 ? 2 : 1);
+	/* REP depends on the last printed character, not just the screen. When
+	 * INPUT_LAST is set no completed cursor/mode command followed that print,
+	 * so repainting its existing cell restores the parser's repeat register.
+	 * In insert mode remove that cell first, then insert it back unchanged. */
+	if ((ictx->flags & INPUT_LAST) && ictx->last.width != 0 &&
+	    s->cx >= ictx->last.width) {
+		x = s->cx - ictx->last.width;
+		evbuffer_add_printf(out, "\033[%u;%uH", y + 1, x + 1);
+		if (mode & MODE_INSERT)
+			evbuffer_add_printf(out, "\033[%uP", ictx->last.width);
+		evbuffer_add(out, ictx->last.data, ictx->last.size);
+	}
+	/* UTF-8 is accumulated separately from escape sequences in tmux. */
+	if (ictx->utf8started)
+		evbuffer_add(out, ictx->utf8data.data, ictx->utf8data.have);
+	evbuffer_add(out, EVBUFFER_DATA(ictx->since_ground),
+	    EVBUFFER_LENGTH(ictx->since_ground));
+	return (out);
+}
