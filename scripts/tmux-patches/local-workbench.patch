+
+/* Read the control client's stdin, forwarded by its existing peer protocol. */
+static void
+control_relay_input(struct client *c, __unused const char *path, int error,
+    int closed, struct evbuffer *buffer, __unused void *arg)
+{
+	struct control_state *cs = c->control_state;
+
+	if (cs == NULL || cs->relay_event == NULL)
+		return;
+	if (closed || error != 0) {
+		cs->relay_input = NULL;
+		c->flags |= CLIENT_EXIT;
+		return;
+	}
+	if (EVBUFFER_LENGTH(cs->relay_event->output) +
+	    EVBUFFER_LENGTH(buffer) > 1024 * 1024) {
+		c->flags |= CLIENT_EXIT;
+		return;
+	}
