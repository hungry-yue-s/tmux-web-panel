+/* Drop a private control transport without waiting for a stopped peer to
+ * drain. Dispatch remains deferred so callers may finish their callbacks. */
+void
+proc_disconnect_peer(struct tmuxpeer *peer)
+{
+	peer->flags |= PEER_BAD;
+	shutdown(peer->ibuf.fd, SHUT_RDWR);
+	event_active(&peer->event, EV_WRITE, 0);
+}
+
+/* Every queued message is bounded by MAX_IMSGSIZE. Control relays use this
+ * conservative bound to disconnect a stopped reader without blocking tmux. */
+u_int
+proc_queued_messages(struct tmuxpeer *peer)
+{
+	return (imsgbuf_queuelen(&peer->ibuf));
+}
